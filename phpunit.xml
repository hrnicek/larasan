<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The suite runs right at PHP's 128M default and crosses it depending on which order
            the heavier feature tests land in — a fatal error in whichever route file happened
            to be loading, which reads as a broken suite rather than as a missing megabyte.
        -->
        <ini name="memory_limit" value="512M"/>

        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <!--
            DB_HOST is deliberately absent: the suite runs on the host, where the environment
            file says 127.0.0.1, and inside the Docker stack, where it says pgsql. Pinning it
            here would send the containers at a database that is not theirs. DB_DATABASE stays
            pinned, so neither runtime can touch its development data.
        -->
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="pm_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!--
            The suite exercises Scout's own API and the reach rule in its query() callback
            without a search engine to start (ADR-0016). What the collection engine cannot
            prove — typo tolerance, ranking, index settings — is proven by the tests that skip
            themselves when nothing answers on MEILISEARCH_HOST.
        -->
        <env name="SCOUT_DRIVER" value="collection"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
