APP_NAME=Larasan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pm
DB_USERNAME=pm
DB_PASSWORD=
# Pinned so renaming APP_NAME does not invalidate existing sessions.
SESSION_COOKIE=larasan_session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
HORIZON_PREFIX=pm_horizon:
# Comma-separated emails allowed to open Horizon outside local/testing; empty denies everyone.
HORIZON_OPERATORS=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


FILESYSTEM_ATTACHMENTS_DISK=attachments
FILESYSTEM_AVATARS_DISK=avatars

# Development-only credentials; generate real ones for any reachable deployment.
REVERB_APP_ID=larasan-local

REVERB_APP_KEY=larasan-local-key

REVERB_APP_SECRET=larasan-local-secret

REVERB_HOST="localhost"

REVERB_PORT=8080

REVERB_SCHEME=http

# Comma-separated websocket origins; defaults to the APP_URL host.
REVERB_ALLOWED_ORIGINS="localhost"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"

VITE_REVERB_HOST="${REVERB_HOST}"

VITE_REVERB_PORT="${REVERB_PORT}"

VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Use "database" or "null" where no Meilisearch instance runs.
SCOUT_DRIVER=meilisearch

# Per-deployment index prefix for a shared Meilisearch instance.
SCOUT_PREFIX=

MEILISEARCH_HOST=http://127.0.0.1:7700

# Required in production, where Meilisearch refuses to run without a master key.
MEILISEARCH_KEY=
