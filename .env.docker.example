# The environment for the Docker stack in compose.yaml. Copy it over `.env`:
#
#     cp .env.docker.example .env
#
# It is `.env.example` with the hostnames a container resolves — pgsql, redis, meilisearch,
# mailpit — instead of 127.0.0.1. `php artisan serve` deliberately does not pass the process
# environment through to a request (ServeCommand::$passthroughVariables), so the file is what the
# served application reads, and setting these in compose.yaml would reach the CLI and nothing else.
#
# `EnvExampleTest` fails if this file and `.env.example` stop declaring the same keys.

APP_NAME=Larasan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=pm
DB_USERNAME=pm
DB_PASSWORD=
# Pinned: the framework's default derives this from APP_NAME, so renaming the product would
# invalidate every signed-in session at once.
SESSION_COOKIE=larasan_session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
HORIZON_PREFIX=pm_horizon:
# Comma-separated addresses that may open Horizon outside local/testing. Empty denies
# everyone — job payloads span every workspace (ADR-0011).
HORIZON_OPERATORS=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


FILESYSTEM_ATTACHMENTS_DISK=attachments

REVERB_APP_ID=

REVERB_APP_KEY=

REVERB_APP_SECRET=

REVERB_HOST=reverb

REVERB_PORT=8080

REVERB_SCHEME=http

# The hosts allowed to open a websocket, comma separated. Defaults to APP_URL's host.
REVERB_ALLOWED_ORIGINS="localhost"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"

VITE_REVERB_HOST=localhost

VITE_REVERB_PORT="${REVERB_PORT}"

VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Search (ADR-0016). Meilisearch matches and ranks; PostgreSQL still decides what may be seen,
# so the application serves without a search engine — only search degrades. Set SCOUT_DRIVER to
# "database" or "null" where no engine runs.
SCOUT_DRIVER=meilisearch

# A prefix per deployment, so a staging import cannot overwrite production's index.
SCOUT_PREFIX=

MEILISEARCH_HOST=http://meilisearch:7700

# Required in every environment Meilisearch is not bound to localhost in. Meilisearch runs
# without a master key in development and refuses to in production.
MEILISEARCH_KEY=
